#!/usr/bin/expect -f
#
# adb_shell.exp —— 在 adb shell 会话内完成认证，然后执行命令
#
#   adb_shell.exp <serial> "<命令>"
#   adb_shell.exp LE62200008802358 "id"
#
# 为什么需要它：E6 的 adbd 每次新建连接都要重新认证，
# 提示 "login with \"adb shell auth\" to continue." 指的是
# **在当前 shell 会话里执行 auth 命令并输入口令**，而不是在宿主机上另开连接。
# 所以必须在同一个会话里：先 auth，再干活。
#
# 口令默认 ydpen2026（rootfs 已被热补丁改成这个明文哈希），
# 可用环境变量 E6_ADB_PASSWORD 覆盖。
#
set timeout 25
set serial [lindex $argv 0]
set cmd [lindex $argv 1]
if {[llength $argv] > 2} { set cmd [join [lrange $argv 1 end] " "] }
set pass "ydpen2026"
if {[info exists ::env(E6_ADB_PASSWORD)]} { set pass $::env(E6_ADB_PASSWORD) }
set sentinel "__E6SHELL_DONE__"

spawn adb -s $serial shell
expect {
    -re "(?i)login with" { }
    -re {[\r\n]} { }
    timeout { puts "TIMEOUT waiting for prompt"; exit 2 }
}
# 会话内执行 auth
send -- "auth\r"
expect {
    -re "(?i)password" { send -- "$pass\r" }
    timeout { puts "TIMEOUT waiting for password"; exit 2 }
}
expect {
    -re "(?i)success" { }
    -re "(?i)denied|incorrect|failed" { puts "AUTH_DENIED"; exit 3 }
    timeout { puts "TIMEOUT waiting for auth result"; exit 2 }
}
# 执行真正的命令，用哨兵标记结束
send -- "$cmd; echo $sentinel\r"
set out ""
expect {
    -re "$sentinel" { }
    timeout { }
}
set out $expect_out(buffer)
regsub -all "$sentinel\r\n" "" $out out
regsub -all "\r" "" $out out
puts -nonewline $out
exit 0
